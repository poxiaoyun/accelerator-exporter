{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "Accelerator Exporter",
  "description": "以 DaemonSet 部署统一 GPU、NPU、vGPU、vNPU 节点指标采集服务。",
  "type": "object",
  "required": [
    "config",
    "containerPort",
    "service",
    "metrics",
    "podResources"
  ],
  "properties": {
    "config": {
      "type": "object",
      "title": "采集配置",
      "description": "配置要采集的加速卡指标源及采集频率。",
      "required": [
        "sources",
        "scrapeInterval",
        "scrapeTimeout",
        "maxConcurrency",
        "diskDiscovery",
        "metrics"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "title": "指标源",
          "description": "全部受支持的指标源默认已开启，无需选择：组件没装的源发现不到端点，等于没配。指标抓取开启且此数组为空时，Chart 会恢复内置指标源；关闭指标抓取后才会进入仅磁盘发现模式。这里只用于覆盖非标准安装的发现参数。排在前面的源优先，两个源覆盖同一观测目标上的同一个指标时，后者的读数按重复丢弃。",
          "x-hidden": true,
          "x-value-type": "object-array",
          "x-cols": 12,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "metrics": {
          "type": "object",
          "title": "指标抓取",
          "description": "控制加速卡指标抓取。启用时，sources 为空会使用 Chart 内置的 NVIDIA、vGPU 和 NPU 指标源；关闭后仅执行磁盘发现和 Node annotation 上报。",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "启用指标抓取",
              "description": "是否抓取 NVIDIA DCGM、vGPU 和 NPU exporter 指标。默认开启。",
              "default": true
            }
          }
        },
        "scrapeInterval": {
          "type": "string",
          "title": "采集间隔",
          "description": "重新发现并采集本节点指标源的时间间隔。",
          "minLength": 2,
          "default": "30s",
          "x-cols": 6
        },
        "scrapeTimeout": {
          "type": "string",
          "title": "单目标超时",
          "description": "单个指标端点一次请求允许的最长时间。",
          "minLength": 2,
          "default": "10s",
          "x-cols": 6
        },
        "maxConcurrency": {
          "type": "integer",
          "title": "最大并发采集数",
          "description": "同时抓取指标端点的最大数量。",
          "minimum": 1,
          "default": 8,
          "x-cols": 6
        },
        "diskDiscovery": {
          "type": "object",
          "title": "空闲磁盘发现",
          "description": "读取节点宿主机的挂载信息，将非系统块设备的磁盘 ID、挂载路径和容量写入 Node annotation，供 BOSS 和 warmup-csi 使用。",
          "required": ["enabled", "hostRoot", "interval"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "启用空闲磁盘发现",
              "description": "是否发布 storage.xiaoshiai.cn/idle-disks annotation。",
              "default": true
            },
            "hostRoot": {
              "type": "string",
              "minLength": 1,
              "title": "宿主机根目录",
              "description": "宿主机 / 目录在 exporter 容器内的只读挂载路径，通常为 /host-root。",
              "default": "/host-root"
            },
            "interval": {
              "type": "string",
              "minLength": 2,
              "title": "磁盘刷新间隔",
              "description": "重新扫描节点磁盘和挂载状态的时间间隔。",
              "default": "30s"
            }
          }
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "title": "容器监听端口",
      "description": "Accelerator Exporter 对外暴露健康检查和统一指标的端口。",
      "minimum": 1,
      "maximum": 65535,
      "default": 9400
    },
    "service": {
      "type": "object",
      "title": "服务配置",
      "description": "配置集群内访问 Accelerator Exporter 的 Service。",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "annotations"
      ],
      "properties": {
        "type": {
          "type": "string",
          "title": "服务类型",
          "enum": [
            "ClusterIP"
          ],
          "default": "ClusterIP"
        },
        "port": {
          "type": "integer",
          "title": "服务端口",
          "minimum": 1,
          "maximum": 65535,
          "default": 9400
        },
        "annotations": {
          "title": "服务注解",
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "metrics": {
      "type": "object",
      "title": "监控配置",
      "description": "配置 Prometheus Operator 对统一指标端点的采集。",
      "additionalProperties": false,
      "required": [
        "serviceMonitor"
      ],
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "title": "Prometheus ServiceMonitor",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "创建 ServiceMonitor",
              "default": false
            },
            "namespace": {
              "type": "string",
              "title": "ServiceMonitor 命名空间",
              "description": "留空时使用当前 Helm Release 的命名空间。",
              "x-hidden": {
                "path": "$.metrics.serviceMonitor.enabled",
                "value": false
              }
            },
            "interval": {
              "type": "string",
              "title": "Prometheus 采集间隔",
              "minLength": 2,
              "default": "30s",
              "x-hidden": {
                "path": "$.metrics.serviceMonitor.enabled",
                "value": false
              }
            },
            "scrapeTimeout": {
              "type": "string",
              "title": "Prometheus 采集超时",
              "minLength": 2,
              "default": "10s",
              "x-hidden": {
                "path": "$.metrics.serviceMonitor.enabled",
                "value": false
              }
            },
            "additionalLabels": {
              "title": "附加标签",
              "$ref": "#/$defs/stringMap",
              "x-hidden": {
                "path": "$.metrics.serviceMonitor.enabled",
                "value": false
              }
            },
            "relabelings": {
              "type": "array",
              "title": "目标重标记规则",
              "x-hidden": {
                "path": "$.metrics.serviceMonitor.enabled",
                "value": false
              },
              "items": {
                "type": "object"
              }
            },
            "metricRelabelings": {
              "type": "array",
              "title": "指标重标记规则",
              "x-hidden": {
                "path": "$.metrics.serviceMonitor.enabled",
                "value": false
              },
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "podResources": {
      "type": "object",
      "title": "设备分配事实",
      "description": "从 kubelet pod-resources socket 读取 Pod 与设备的分配关系，用于生成 accelerator_pod_info。目录以只读方式挂载到容器内同名路径。",
      "properties": {
        "hostPath": {
          "type": "string",
          "title": "pod-resources 目录",
          "description": "宿主机上 kubelet pod-resources socket 所在目录。留空表示该集群不暴露该接口：关系层为空，身份来自样本的源照常产出设备层，volcano-vgpu 例外 —— 切片编号只在分配事实里，它拿不到编号。",
          "default": "/var/lib/kubelet/pod-resources",
          "x-cols": 12
        }
      }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "rule"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "address"
        ]
      },
      "oneOf": [
        {
          "required": [
            "podMonitor"
          ],
          "not": {
            "required": [
              "serviceMonitor"
            ]
          }
        },
        {
          "required": [
            "serviceMonitor"
          ],
          "not": {
            "required": [
              "podMonitor"
            ]
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "源名称",
          "description": "这一份配置的名字，取采集源的组件名。它成为每个抓取目标名的前缀，也是 accelerator_exporter_* 的 source 取值。",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "title": "采集规则",
          "description": "内置规则名，它决定 device_type、device_mode、vendor 以及每个观测目标的身份。",
          "enum": [
            "nvidia-dcgm",
            "volcano-vgpu",
            "ascend-npu"
          ]
        },
        "labels": {
          "type": "object",
          "title": "固定标签",
          "description": "只允许钉住 model，供本族指标不带型号的源使用。node 永远是本进程所在的节点，其余标签由样本解析。",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "title": "型号"
            }
          }
        },
        "podMonitor": {
          "$ref": "#/$defs/monitorSpec",
          "title": "按 Pod 发现"
        },
        "serviceMonitor": {
          "$ref": "#/$defs/monitorSpec",
          "title": "按 Service 发现"
        }
      }
    },
    "monitorSpec": {
      "type": "object",
      "required": [
        "selector",
        "port"
      ],
      "additionalProperties": false,
      "properties": {
        "namespaces": {
          "type": "array",
          "title": "命名空间",
          "items": {
            "type": "string"
          }
        },
        "namespaceSelector": {
          "type": "object",
          "title": "命名空间选择器",
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "boolean",
              "title": "全部命名空间",
              "description": "与 matchNames 互斥。"
            },
            "matchNames": {
              "type": "array",
              "title": "命名空间列表",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "selector": {
          "type": "object",
          "title": "标签选择器",
          "required": [
            "matchLabels"
          ],
          "additionalProperties": false,
          "properties": {
            "matchLabels": {
              "title": "精确匹配",
              "$ref": "#/$defs/stringMap"
            },
            "matchExpressions": {
              "type": "array",
              "title": "表达式匹配",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "port": {
          "type": [
            "string",
            "integer"
          ],
          "title": "端口",
          "description": "容器或 Service 的端口名，或端口号。"
        },
        "path": {
          "type": "string",
          "title": "指标路径",
          "description": "留空时为 /metrics。"
        },
        "scheme": {
          "type": "string",
          "title": "协议",
          "enum": [
            "http",
            "https"
          ]
        }
      }
    }
  }
}
