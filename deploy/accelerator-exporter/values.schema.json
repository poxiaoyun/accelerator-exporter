{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "Accelerator Exporter",
  "description": "部署统一 GPU、NPU、vGPU、vNPU 指标聚合服务。",
  "type": "object",
  "required": ["config", "containerPort", "service", "metrics"],
  "properties": {
    "config": {
      "type": "object",
      "title": "采集配置",
      "description": "选择需要采集的加速卡指标源，并配置采集频率。",
      "required": ["scrapeInterval", "scrapeTimeout", "maxConcurrency"],
      "anyOf": [
        {
          "required": ["sources"],
          "properties": {
            "sources": {
              "minItems": 1
            }
          }
        },
        {
          "required": ["customSources"],
          "properties": {
            "customSources": {
              "minItems": 1
            }
          }
        }
      ],
      "properties": {
        "sources": {
          "type": "array",
          "title": "底层指标源",
          "description": "选择集群中已经安装的指标采集组件。",
          "default": ["nvidia-dcgm", "volcano-vgpu", "ascend-npu", "ascend-vnpu"],
          "uniqueItems": true,
          "x-value-type": "string-array",
          "x-render": "multi-enum",
          "x-cols": 12,
          "items": {
            "type": "string",
            "enum": ["nvidia-dcgm", "volcano-vgpu", "ascend-npu", "ascend-vnpu"],
            "enumNames": ["NVIDIA GPU（DCGM）", "Volcano vGPU", "Ascend NPU", "Ascend vNPU"]
          }
        },
        "customSources": {
          "type": "array",
          "title": "自定义指标源",
          "description": "供非标准安装场景通过 Values 文件注入完整指标源定义。",
          "default": [],
          "x-hidden": true,
          "items": {
            "type": "object"
          }
        },
        "scrapeInterval": {
          "type": "string",
          "title": "采集间隔",
          "description": "重新发现并采集全部指标源的时间间隔。",
          "minLength": 2,
          "default": "15s",
          "x-cols": 6
        },
        "scrapeTimeout": {
          "type": "string",
          "title": "单目标超时",
          "description": "单个指标端点一次请求允许的最长时间。",
          "minLength": 2,
          "default": "5s",
          "x-cols": 6
        },
        "maxConcurrency": {
          "type": "integer",
          "title": "最大并发采集数",
          "description": "同时抓取指标端点的最大数量。",
          "minimum": 1,
          "default": 8,
          "x-cols": 6
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "title": "容器监听端口",
      "description": "Accelerator Exporter 对外暴露健康检查和统一指标的端口。",
      "minimum": 1,
      "maximum": 65535,
      "default": 9400
    },
    "service": {
      "type": "object",
      "title": "服务配置",
      "description": "配置集群内访问 Accelerator Exporter 的 Service。",
      "additionalProperties": false,
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": {
          "type": "string",
          "title": "服务类型",
          "enum": ["ClusterIP"],
          "default": "ClusterIP"
        },
        "port": {
          "type": "integer",
          "title": "服务端口",
          "minimum": 1,
          "maximum": 65535,
          "default": 9400
        },
        "annotations": {
          "title": "服务注解",
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "metrics": {
      "type": "object",
      "title": "监控配置",
      "description": "配置 Prometheus Operator 对统一指标端点的采集。",
      "additionalProperties": false,
      "required": ["serviceMonitor"],
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "title": "Prometheus ServiceMonitor",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "创建 ServiceMonitor",
              "default": false
            },
            "namespace": {
              "type": "string",
              "title": "ServiceMonitor 命名空间",
              "description": "留空时使用当前 Helm Release 的命名空间。",
              "x-hidden": {"path": "$.metrics.serviceMonitor.enabled", "value": false}
            },
            "interval": {
              "type": "string",
              "title": "Prometheus 采集间隔",
              "minLength": 2,
              "default": "30s",
              "x-hidden": {"path": "$.metrics.serviceMonitor.enabled", "value": false}
            },
            "scrapeTimeout": {
              "type": "string",
              "title": "Prometheus 采集超时",
              "minLength": 2,
              "default": "10s",
              "x-hidden": {"path": "$.metrics.serviceMonitor.enabled", "value": false}
            },
            "additionalLabels": {
              "title": "附加标签",
              "$ref": "#/$defs/stringMap",
              "x-hidden": {"path": "$.metrics.serviceMonitor.enabled", "value": false}
            },
            "relabelings": {
              "type": "array",
              "title": "目标重标记规则",
              "x-hidden": {"path": "$.metrics.serviceMonitor.enabled", "value": false},
              "items": {
                "type": "object"
              }
            },
            "metricRelabelings": {
              "type": "array",
              "title": "指标重标记规则",
              "x-hidden": {"path": "$.metrics.serviceMonitor.enabled", "value": false},
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    }
  }
}
